NODE_ENV=development
PORT=3016
DATABASE_URL=postgresql://erpfreela:erpfreela@localhost:5440/erpfreela?schema=public
# 16+ caracteres; em produção gere com `openssl rand -hex 32` NO SERVIDOR.
JWT_SECRET=dev-erp-freela-segredo-local-123
JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:3026
# Leitura de PDF (NF e DDA) pela API da Anthropic. Vazia = "Leitura de PDF não configurada".
ANTHROPIC_API_KEY=
AI_PDF_MODEL=claude-opus-5-5
# Atrás de nginx em produção: true (ver README).
TRUST_PROXY=false
# CERTIFICADO_SECRET= (openssl rand -hex 32 NO servidor; sem ela o certificado digital fica desligado)
