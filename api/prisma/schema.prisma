// Freela ERP — espelho 1:1 do banco do protótipo Lovable (drizzle/migrations 0000–0006).
// Nomes de tabela/coluna IGUAIS aos do Supabase: a migração de dados do Lovable vira cópia linha a linha.
// Views, funções, gatilho, CHECKs e as linhas fixas (configuracoes/sazonalidade/subgrupos) ficam no SQL da migração
// (o Prisma não os expressa). `numeric` = `Decimal @db.Decimal` (sem precisão, igual ao Postgres do protótipo).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum app_role {
  admin
  loja
}

/// Substitui auth.users + profiles + user_roles do Supabase (um perfil por pessoa, como a tela de Usuários assumia).
model users {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique
  nome          String   @default("")
  password_hash String
  perfil        app_role
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}

/// Chave de IA da empresa para ler PDF (nota de compra e DDA). Não existe no Lovable (lá a IA era o gateway da própria Lovable).
/// Uma linha só (id = 1): o provedor escolhido e a chave CIFRADA (AES-256-GCM); a chave nunca sai do servidor, só os 4 últimos caracteres.
model ia_chave {
  id             Int      @id @default(1)
  provedor       String
  chave_cifrada  String
  dica           String
  atualizado_em  DateTime @default(now()) @db.Timestamptz(6)
  atualizado_por String?  @db.Uuid
}

/// Certificado digital A1 da empresa (uma linha, id = 1). `material_cifrado` = chave privada + certificado + cadeia, CIFRADOS (AES-256-GCM), sem a senha e sem o .pfx; nunca sai do servidor.
/// As demais colunas são só os dados públicos do certificado, mostrados na tela de Configurações.
model certificado_digital {
  id                Int      @id @default(1)
  material_cifrado  String
  titular           String
  cnpj              String   @db.Char(14)
  tipo              String
  politica_oid      String?
  emissor           String
  numero_serie      String
  impressao_digital String   @db.Char(64)
  valido_de         DateTime @db.Timestamptz(6)
  valido_ate        DateTime @db.Timestamptz(6)
  cadeia_conferida  Boolean
  enviado_em        DateTime @default(now()) @db.Timestamptz(6)
  enviado_por       String?  @db.Uuid
  enviado_por_nome  String
}

/// Trilha de quem enviou, substituiu ou removeu o certificado. Guarda só dados públicos (nunca o material cifrado).
model certificado_digital_historico {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evento            String
  cnpj              String   @db.Char(14)
  titular           String
  numero_serie      String
  impressao_digital String   @db.Char(64)
  valido_ate        DateTime @db.Timestamptz(6)
  feito_por         String?  @db.Uuid
  feito_por_nome    String
  feito_em          DateTime @default(now()) @db.Timestamptz(6)

  @@index([feito_em(sort: Desc)])
}

/// Busca de notas na SEFAZ: uma linha por (ambiente, CNPJ) com o ponteiro NSU, a agenda e a situação. Nasce desligada (`busca_ligada = false`). Só nossa.
model sefaz_distribuicao {
  ambiente             String
  cnpj                 String    @db.Char(14)
  busca_ligada         Boolean   @default(false)
  situacao             String    @default("ok")
  mensagem             String?
  aviso                String?
  ult_nsu              BigInt    @default(0)
  max_nsu              BigInt?
  primeira_consulta_em DateTime? @db.Timestamptz(6)
  ultima_consulta_em   DateTime? @db.Timestamptz(6)
  proxima_consulta_em  DateTime? @db.Timestamptz(6)
  bloqueado_ate        DateTime? @db.Timestamptz(6)
  em_andamento_desde   DateTime? @db.Timestamptz(6)
  falhas_seguidas      Int       @default(0)
  alterada_por         String?   @db.Uuid
  alterada_por_nome    String?
  alterada_em          DateTime? @db.Timestamptz(6)
  criada_em            DateTime  @default(now()) @db.Timestamptz(6)

  @@id([ambiente, cnpj])
}

/// Trilha (só inserção) de quem ligou e desligou a busca e das paradas automáticas. `feito_por*` nulos na parada automática.
model sefaz_distribuicao_historico {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ambiente       String
  cnpj           String   @db.Char(14)
  evento         String
  situacao       String
  c_stat         Int?
  mensagem       String?
  feito_por      String?  @db.Uuid
  feito_por_nome String?
  feito_em       DateTime @default(now()) @db.Timestamptz(6)

  @@index([ambiente, cnpj, feito_em(sort: Desc)])
}

/// Diário das consultas à SEFAZ (só inserção, mais o fechamento da própria linha): aberta antes de enviar (`resultado` nulo), fechada depois.
/// `ciclo_id` agrupa as páginas de um ciclo; `dh_resp` guarda o texto como veio.
model sefaz_consultas {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ciclo_id          String    @db.Uuid
  ambiente          String
  cnpj              String    @db.Char(14)
  servico           String    @default("distNSU")
  origem            String
  iniciada_por      String?   @db.Uuid
  iniciada_por_nome String?
  ult_nsu_enviado   BigInt
  iniciada_em       DateTime  @db.Timestamptz(6)
  terminada_em      DateTime? @db.Timestamptz(6)
  resultado         String?
  c_stat            Int?
  x_motivo          String?
  dh_resp           String?
  ult_nsu           BigInt?
  max_nsu           BigInt?
  documentos        Int?
  erro_code         String?

  lacunas              sefaz_lacunas[]
  documentos_recebidos sefaz_documentos[]

  @@index([ambiente, cnpj, iniciada_em(sort: Desc)])
}

/// Buracos na sequência de NSU (outro sistema consumiu a faixa ou a resposta se perdeu). `preenchida_em` fica para a etapa do consNSU.
model sefaz_lacunas {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ambiente      String
  cnpj          String    @db.Char(14)
  nsu_de        BigInt
  nsu_ate       BigInt
  causa         String
  consulta_id   String    @db.Uuid
  detectada_em  DateTime  @default(now()) @db.Timestamptz(6)
  preenchida_em DateTime? @db.Timestamptz(6)

  consulta sefaz_consultas @relation(fields: [consulta_id], references: [id], onDelete: Restrict)
}

/// Documentos recebidos da SEFAZ, um por NSU (só inserção); é também a guarda do XML. `conteudo_bruto` só existe quando `tipo = 'ilegivel'`.
model sefaz_documentos {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ambiente           String
  cnpj               String    @db.Char(14)
  nsu                BigInt
  schema             String
  tipo               String
  chave              String?   @db.VarChar(44)
  tp_evento          String?   @db.VarChar(6)
  xml                String?
  conteudo_bruto     String?
  consulta_id        String    @db.Uuid
  recebido_em        DateTime  @default(now()) @db.Timestamptz(6)
  processado_em      DateTime? @db.Timestamptz(6)
  erro_processamento String?

  consulta       sefaz_consultas @relation(fields: [consulta_id], references: [id], onDelete: Restrict)
  notas_resumo   notas_sefaz[]   @relation("nota_sefaz_resumo")
  notas_completo notas_sefaz[]   @relation("nota_sefaz_completo")

  @@unique([ambiente, cnpj, nsu])
  @@index([chave])
}

/// A caixa "Notas da SEFAZ" da Entrada de Notas: uma linha por chave de acesso e ambiente. `ignorada_*`/`motivo_*` guardam a última ação do admin.
model notas_sefaz {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ambiente              String
  cnpj_destinatario     String    @db.Char(14)
  chave                 String    @db.VarChar(44)
  emitente_cnpj         String    @db.VarChar(14)
  emitente_nome         String    @default("")
  numero                String
  serie                 String
  emitida_em            DateTime? @db.Timestamptz(6)
  autorizada_em         DateTime? @db.Timestamptz(6)
  valor_total           Decimal?  @db.Decimal(15, 2)
  tp_nf                 Int?      @db.SmallInt
  fin_nfe               Int?      @db.SmallInt
  nat_op                String?
  situacao_sefaz        String
  cancelada_em          DateTime? @db.Timestamptz(6)
  resumo_id             String?   @db.Uuid
  documento_completo_id String?   @db.Uuid
  ignorada_em           DateTime? @db.Timestamptz(6)
  ignorada_por          String?   @db.Uuid
  ignorada_por_nome     String?
  motivo_ignorar        String?
  motivo_texto          String?
  criada_em             DateTime  @default(now()) @db.Timestamptz(6)
  atualizada_em         DateTime  @default(now()) @db.Timestamptz(6)

  resumo             sefaz_documentos? @relation("nota_sefaz_resumo", fields: [resumo_id], references: [id], onDelete: Restrict)
  documento_completo sefaz_documentos? @relation("nota_sefaz_completo", fields: [documento_completo_id], references: [id], onDelete: Restrict)
  manifestacoes      sefaz_manifestacoes[]

  @@unique([ambiente, chave])
  @@index([ambiente, emitida_em(sort: Desc)])
  @@index([emitente_cnpj, numero])
}

/// Respostas à SEFAZ: uma linha por (ambiente, CNPJ) com a chave "Ligar as respostas", a situação e a pausa. Nasce desligada. Só nossa.
model sefaz_manifestacao {
  ambiente          String
  cnpj              String    @db.Char(14)
  ligada            Boolean   @default(false)
  situacao          String    @default("ok")
  mensagem          String?
  pausa_ate         DateTime? @db.Timestamptz(6)
  falhas_seguidas   Int       @default(0)
  ligada_em         DateTime? @db.Timestamptz(6)
  alterada_por      String?   @db.Uuid
  alterada_por_nome String?
  alterada_em       DateTime? @db.Timestamptz(6)
  criada_em         DateTime  @default(now()) @db.Timestamptz(6)

  @@id([ambiente, cnpj])
}

/// Diário dos lotes de evento enviados à SEFAZ (aberto antes de enviar, fechado na própria linha). Fora de `sefaz_consultas` de propósito.
model sefaz_eventos_lotes {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ambiente     String
  cnpj         String    @db.Char(14)
  id_lote      BigInt
  iniciado_em  DateTime  @db.Timestamptz(6)
  terminado_em DateTime? @db.Timestamptz(6)
  resultado    String?
  c_stat       Int?
  x_motivo     String?
  eventos      Int?
  erro_code    String?

  manifestacoes sefaz_manifestacoes[]

  @@index([ambiente, cnpj, iniciado_em(sort: Desc)])
}

/// Um evento de resposta por linha (a situação muda, o resto não). Os índices únicos parciais (`evento_ativo`, `uma_final`) só existem no SQL.
/// `xml_evento` traz o certificado público da folha: nunca em log nem em resposta da API.
model sefaz_manifestacoes {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nota_sefaz_id     String    @db.Uuid
  ambiente          String
  cnpj              String    @db.Char(14)
  chave             String    @db.VarChar(44)
  tp_evento         String
  n_seq             Int       @default(1) @db.SmallInt
  x_just            String?
  origem            String
  pedida_por        String?   @db.Uuid
  pedida_por_nome   String?
  pedida_em         DateTime  @default(now()) @db.Timestamptz(6)
  enviar_apos       DateTime  @db.Timestamptz(6)
  situacao          String    @default("na_fila")
  tentativas        Int       @default(0) @db.SmallInt
  lote_id           String?   @db.Uuid
  dh_evento         String?
  c_stat            Int?
  x_motivo          String?
  n_prot            String?
  dh_reg_evento     String?
  xml_evento        String?
  xml_retorno       String?
  impressao_digital String?   @db.Char(64)
  saiu_em           DateTime? @db.Timestamptz(6)
  criada_em         DateTime  @default(now()) @db.Timestamptz(6)
  atualizada_em     DateTime  @default(now()) @db.Timestamptz(6)

  nota notas_sefaz          @relation(fields: [nota_sefaz_id], references: [id], onDelete: Restrict)
  lote sefaz_eventos_lotes? @relation(fields: [lote_id], references: [id], onDelete: Restrict)

  @@index([ambiente, cnpj, situacao, enviar_apos])
  @@index([nota_sefaz_id])
  @@index([lote_id])
}

/// Cupom fiscal (NFC-e): o emitente (uma linha, id = 1). CNPJ, razão social e nome fantasia continuam em `configuracoes`. Só nossa.
/// `cupom_lanca_venda` nulo = não respondido. Fora de `configuracoes` de propósito (a loja lê `configuracoes` inteira).
model nfce_emitente {
  id                         Int       @id @default(1)
  ie                         String?
  crt                        Int?      @db.SmallInt
  logradouro                 String?
  numero                     String?
  complemento                String?
  bairro                     String?
  cep                        String?   @db.Char(8)
  cod_municipio              String    @default("3556206") @db.Char(7)
  municipio                  String    @default("Valinhos")
  uf                         String    @default("SP") @db.Char(2)
  telefone                   String?
  nat_op                     String    @default("VENDA")
  inf_cpl                    String?
  resp_tec_cnpj              String?   @db.Char(14)
  resp_tec_contato           String?
  resp_tec_email             String?
  resp_tec_fone              String?
  series_outro_sistema       Int[]     @default([]) @db.SmallInt
  sem_outro_sistema          Boolean   @default(false)
  cupom_lanca_venda          Boolean?
  cupom_lanca_venda_por      String?   @db.Uuid
  cupom_lanca_venda_por_nome String?
  cupom_lanca_venda_em       DateTime? @db.Timestamptz(6)
  tp_regime_ibscbs           Int?      @db.SmallInt
  atualizado_por             String?   @db.Uuid
  atualizado_por_nome        String?
  atualizado_em              DateTime? @db.Timestamptz(6)
}

/// Cupom fiscal: uma linha por ambiente (`homologacao`, `producao`), travada com FOR UPDATE na reserva do número. Nasce com a emissão desligada.
/// `csc_cifrado` (AES-256-GCM, rótulo `nfce-csc`) nunca sai do servidor; só `csc_dica` (4 últimos caracteres).
model nfce_ambientes {
  ambiente          String    @id
  emissao_ligada    Boolean   @default(false)
  ligada_cnpj       String?   @db.Char(14)
  ligada_serie      Int?      @db.SmallInt
  serie             Int?      @db.SmallInt
  proximo_numero    BigInt    @default(1)
  csc_cifrado       String?
  csc_dica          String?   @db.Char(4)
  id_csc            Int?
  situacao          String    @default("ok")
  mensagem          String?
  bloqueado_ate     DateTime? @db.Timestamptz(6)
  ultimo_656_em     DateTime? @db.Timestamptz(6)
  ultimo_status_em  DateTime? @db.Timestamptz(6)
  alterada_por      String?   @db.Uuid
  alterada_por_nome String?
  alterada_em       DateTime? @db.Timestamptz(6)
}

/// Trilha (só inserção) de ligar, desligar, paradas automáticas e mudanças de configuração do cupom. `campos` = nomes, nunca o valor do CSC.
model nfce_ambientes_historico {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ambiente       String
  evento         String
  campos         String[] @default([])
  situacao       String
  c_stat         Int?
  mensagem       String?
  feito_por      String?  @db.Uuid
  feito_por_nome String?
  feito_em       DateTime @default(now()) @db.Timestamptz(6)

  @@index([ambiente, feito_em(sort: Desc)])
}

/// Perfil fiscal do cupom (CFOP, CSOSN ou CST do ICMS, PIS/COFINS e os campos do IBS/CBS). Perfil em uso só é desativado.
model nfce_perfis_fiscais {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                String    @unique
  cfop                String    @db.Char(4)
  csosn               String?   @db.Char(3)
  cst_icms            String?   @db.Char(2)
  aliq_icms           Decimal?  @db.Decimal(5, 2)
  pis_cst             String?   @db.Char(2)
  cofins_cst          String?   @db.Char(2)
  c_ativ_sn           String?   @db.Char(2)
  ibs_sn_aliq         Decimal?  @db.Decimal(7, 4)
  cbs_sn_aliq         Decimal?  @db.Decimal(7, 4)
  ibscbs_cst          String?   @db.Char(3)
  ibscbs_cclass_trib  String?   @db.Char(6)
  ativo               Boolean   @default(true)
  criado_em           DateTime  @default(now()) @db.Timestamptz(6)
  atualizado_por      String?   @db.Uuid
  atualizado_por_nome String?
  atualizado_em       DateTime? @db.Timestamptz(6)

  itens nfce_itens[]
}

/// Dados fiscais do item do cardápio (1 para 1). NCM ou perfil nulo = cadastro incompleto; GTIN nulo = "SEM GTIN".
model nfce_itens {
  item_cardapio_id    String    @id @db.Uuid
  perfil_fiscal_id    String?   @db.Uuid
  ncm                 String?   @db.Char(8)
  cest                String?   @db.Char(7)
  gtin                String?   @db.VarChar(14)
  origem              Int       @default(0) @db.SmallInt
  descricao_cupom     String?   @db.VarChar(120)
  unidade             String?   @db.VarChar(6)
  atualizado_por      String?   @db.Uuid
  atualizado_por_nome String?
  atualizado_em       DateTime? @db.Timestamptz(6)

  item_cardapio itens_cardapio       @relation(fields: [item_cardapio_id], references: [id], onDelete: Cascade)
  perfil        nfce_perfis_fiscais? @relation(fields: [perfil_fiscal_id], references: [id], onDelete: Restrict)

  @@index([perfil_fiscal_id])
}

/// Um cupom fiscal por linha (a única tabela com estado). Imutável depois de autorizado (gatilho `nfce_cupons_imutavel`; DELETE sempre
/// recusado). Os índices únicos parciais `nfce_cupons_numero_vivo` e `nfce_cupons_chave_viva` e o parcial `nfce_cupons_pendentes` só
/// existem no SQL. `venda_*` = marcador da venda no estoque (as funções `nfce_lancar_venda`/`nfce_desfazer_venda` gravam os `_em`).
/// `xml_autorizado` (o `nfeProc`) só sai pela rota própria.
model nfce_cupons {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ambiente               String
  serie                  Int       @db.SmallInt
  numero                 BigInt
  chave                  String    @db.VarChar(44)
  c_nf                   String    @db.Char(8)
  tp_emis                Int       @default(1) @db.SmallInt
  dh_cont                DateTime? @db.Timestamptz(6)
  x_just                 String?
  dh_emi                 DateTime  @db.Timestamptz(6)
  situacao               String    @default("enviando")
  numero_reaproveitavel  Boolean   @default(true)
  envios                 Int       @default(0) @db.SmallInt
  chave_idempotencia     String    @unique @db.Uuid
  pedido_hash            String    @db.Char(64)
  lanca_venda            Boolean
  consumidor_doc         String?   @db.VarChar(14)
  valor_produtos         Decimal   @db.Decimal(15, 2)
  valor_desconto         Decimal   @default(0) @db.Decimal(15, 2)
  valor_total            Decimal   @db.Decimal(15, 2)
  valor_troco            Decimal   @default(0) @db.Decimal(15, 2)
  autorizada_em          DateTime? @db.Timestamptz(6)
  n_prot                 String?   @db.VarChar(17)
  c_stat                 Int?
  x_motivo               String?
  alerta_c_msg           String?
  alerta_x_msg           String?
  dig_val                String?
  xml_autorizado         String?
  cancelado_em           DateTime? @db.Timestamptz(6)
  cancelamento_motivo    String?
  cancelamento_n_prot    String?   @db.VarChar(17)
  cancelamento_pedido_em DateTime? @db.Timestamptz(6)
  venda_lancada_em       DateTime? @db.Timestamptz(6)
  venda_desfeita_em      DateTime? @db.Timestamptz(6)
  venda_erro             String?
  descartado_em          DateTime? @db.Timestamptz(6)
  descarte_motivo        String?
  descartado_por         String?   @db.Uuid
  descartado_por_nome    String?
  emitido_por            String?   @db.Uuid
  emitido_por_nome       String?
  criado_em              DateTime  @default(now()) @db.Timestamptz(6)
  atualizado_em          DateTime  @default(now()) @db.Timestamptz(6)

  itens        nfce_cupom_itens[]
  pagamentos   nfce_cupom_pagamentos[]
  envios_sefaz nfce_envios[]
  vendas       vendas[]

  @@index([ambiente, criado_em(sort: Desc)])
}

/// Linha do cupom: a fotografia do item na emissão. `nome_cardapio` = `itens_cardapio.nome` do momento (o `produto_relatorio` da venda).
/// Só muda com o cupom fora de autorizado/cancelando/denegado/cancelado (gatilho `nfce_filhos_imutaveis`), fora o SET NULL do cardápio.
model nfce_cupom_itens {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cupom_id           String   @db.Uuid
  n_item             Int      @db.SmallInt
  item_cardapio_id   String?  @db.Uuid
  nome_cardapio      String
  c_prod             String   @db.VarChar(60)
  x_prod             String   @db.VarChar(120)
  ncm                String   @db.Char(8)
  cest               String?  @db.Char(7)
  gtin               String?  @db.VarChar(14)
  origem             Int      @db.SmallInt
  unidade            String   @db.VarChar(6)
  cfop               String   @db.Char(4)
  csosn              String?  @db.Char(3)
  cst_icms           String?  @db.Char(2)
  aliq_icms          Decimal? @db.Decimal(5, 2)
  pis_cst            String?  @db.Char(2)
  cofins_cst         String?  @db.Char(2)
  c_ativ_sn          String?  @db.Char(2)
  ibs_sn_aliq        Decimal? @db.Decimal(7, 4)
  cbs_sn_aliq        Decimal? @db.Decimal(7, 4)
  ibscbs_cst         String?  @db.Char(3)
  ibscbs_cclass_trib String?  @db.Char(6)
  perfil_nome        String
  quantidade         Decimal  @db.Decimal(15, 4)
  valor_unitario     Decimal  @db.Decimal(15, 2)
  valor_bruto        Decimal  @db.Decimal(15, 2)
  valor_desconto     Decimal  @default(0) @db.Decimal(15, 2)

  cupom         nfce_cupons     @relation(fields: [cupom_id], references: [id], onDelete: Restrict)
  item_cardapio itens_cardapio? @relation(fields: [item_cardapio_id], references: [id], onDelete: SetNull)

  @@unique([cupom_id, n_item])
  @@index([item_cardapio_id])
}

/// Formas de pagamento do cupom. Mesmo gatilho de imutável dos itens.
model nfce_cupom_pagamentos {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cupom_id   String  @db.Uuid
  ordem      Int     @db.SmallInt
  t_pag      String  @db.Char(2)
  valor      Decimal @db.Decimal(15, 2)
  tp_integra Int?    @db.SmallInt

  cupom nfce_cupons @relation(fields: [cupom_id], references: [id], onDelete: Restrict)

  @@unique([cupom_id, ordem])
}

/// Diário das chamadas NFC-e à SEFAZ (só inserção, mais o fechamento da própria linha): prova das travas do 656 e guarda dos eventos.
/// `cupom_id` nulo só no `status`; `id_lote` sai da sequence `nfce_id_lote_seq` (só no SQL). `xml_enviado` nunca contém o CSC.
model nfce_envios {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ambiente              String
  cupom_id              String?   @db.Uuid
  servico               String
  tentativa             Int?      @db.SmallInt
  id_lote               BigInt?
  iniciada_em           DateTime  @db.Timestamptz(6)
  terminada_em          DateTime? @db.Timestamptz(6)
  resultado             String?
  c_stat_lote           Int?
  c_stat                Int?
  x_motivo              String?
  n_prot                String?   @db.VarChar(17)
  dh_recbto             String?
  dig_val               String?
  rejeicao              Boolean   @default(false)
  erro_code             String?
  duracao_ms            Int?
  xml_enviado           String?
  xml_retorno           String?
  iniciada_por          String?   @db.Uuid
  iniciada_por_nome     String?
  certificado_impressao String?   @db.Char(64)

  cupom nfce_cupons? @relation(fields: [cupom_id], references: [id], onDelete: Restrict)

  @@index([ambiente, iniciada_em(sort: Desc)])
  @@index([cupom_id])
}

