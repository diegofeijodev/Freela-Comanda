# /opt/erp-freela/.env (chmod 600). Gere os segredos NO SERVIDOR: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
# Endereço(s) do web (Vercel / domínio), separados por vírgula.
CORS_ORIGINS=https://www.freelacomanda.com.br,https://freelacomanda.com.br,https://freela-comanda.vercel.app
# Leitura de PDF de NF e DDA. Vazia = a tela mostra "Leitura de PDF não configurada" (o XML continua funcionando).
ANTHROPIC_API_KEY=
AI_PDF_MODEL=claude-opus-5-5
# CERTIFICADO_SECRET= (openssl rand -hex 32 NO servidor; sem ela o certificado digital fica desligado)
# SEFAZ_DFE_AMBIENTE=desligado (desligado | homologacao | producao; producao só com o "eu autorizo" do dono)
# SEFAZ_MANIFESTACAO=desligada (desligada | ligada; ligada só depois do OK do contador e do "eu autorizo" do dono)
